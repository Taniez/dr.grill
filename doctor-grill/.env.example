# TiDB Cloud: copy the MySQL connection details from Connect.
DB_DRIVER=tidb
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=doctor_grill
# Optional alternative: mysql://URL_ENCODED_USER:URL_ENCODED_PASSWORD@HOST:4000/doctor_grill
# DATABASE_URL takes precedence over the TIDB_* connection fields.
DATABASE_URL=
# Optional certificate authority file, if supplied by your TiDB cluster.
TIDB_CA_PATH=
# db:setup creates the database. Set false if it is already created by an administrator.
DB_CREATE_DATABASE=true
# Keep false in production: install schema explicitly with npm run db:setup.
DB_AUTO_SETUP=false
ADMIN_PASSWORD=
PORT=3001
HOST=127.0.0.1
# Set true when the published website uses HTTPS.
COOKIE_SECURE=false
